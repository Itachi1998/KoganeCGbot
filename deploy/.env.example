# Copy to deploy/.env (never commit the real one).
DISCORD_TOKEN=paste-your-bot-token-here

# Long-term storage: sqlite (default, a file in the gamedata volume) or dynamodb.
CULLING_DB=sqlite
# For dynamodb: the region of the CullingGame table. On EC2, give the instance an IAM role
# that can read/write that table instead of putting keys here.
# AWS_REGION=us-east-1
